# Copy to .env and fill in real values. .env is gitignored here (see the repo
# .gitignore) since it holds a real MASTER_KEY, MONGODB_URI and, once you set
# them, S3/SMTP credentials. The two app containers (opensign-client,
# opensign-server) read this via env_file; docker-compose.yml.sample derives
# SERVER_URL / PUBLIC_URL / REACT_APP_SERVERURL from OPEN_PUBLIC_HOST.

TZ=Europe/Berlin

# Where this repo's CI publishes the two app images: ghcr.io/<github owner,
# lowercase>. docker-compose.yml.sample pulls
# ${IMAGE_PREFIX}/opensign-client:latest and ${IMAGE_PREFIX}/opensign-server:latest.
IMAGE_PREFIX=ghcr.io/your-github-user

# DNS name the whole OpenSign app is reachable at -- both the web client and
# the /api prefix (see the traefik labels in docker-compose.yml.sample).
# Replace with your real subdomain.
OPEN_PUBLIC_HOST=opensign.example.com

# --- OpenSign app ---
# A 12 character long app identifier shared by client + server. Keep it as
# 'opensign' unless you have a reason to change it (the server's index.js and
# the client both key off this value).
APP_ID=opensign
# Name of the app. It will be visible in the verification emails sent out.
appName=open_sign_server
# A 12 character long random secret key that allows access to all the data.
# It is used in the Parse dashboard config to view all the data in the
# database. CHANGE THIS from the upstream default -- e.g.
#   docker run --rm node:22 sh -c "node -e \"console.log(require('crypto').randomBytes(6).toString('base64').replace(/[^a-zA-Z0-9]/g,'').slice(0,12))\""
MASTER_KEY=XnAadwKxxByMr
# Path on which the Parse.js API is mounted. Do not change this (the value is
# hardcoded in the source; it will be removed in a coming version).
PARSE_MOUNT=/app
# Set to true to generate sourcemaps for debugging the client.
GENERATE_SOURCEMAP=false

# --- Database (opensign-mongo) ---
# URI to reach the mongo service (service name 'mongo' from
# docker-compose.yml.sample). OpenSign ships no auth -- keep mongo off the
# public internet.
MONGODB_URI=mongodb://mongo:27017/OpenSignDB

# --- Document storage ---
# Local disk storage (kept in the opensign-files volume) -- the simplest
# option, no S3 account needed. Leave this true unless you set DO_* below.
USE_LOCAL=true
# DigitalOcean Space / AWS S3 compatible storage for uploaded documents.
# Only needed if USE_LOCAL=false.
DO_SPACE=DOSPACENAME
DO_ENDPOINT=ams3.digitaloceanspaces.com
DO_BASEURL=https://DOSPACENAME.ams3.digitaloceanspaces.com
DO_ACCESS_KEY_ID=
DO_SECRET_ACCESS_KEY=
DO_REGION=us-west

# --- Email (user verification, signing invites) ---
# OpenSign needs email to send verification + signing notifications. Choose
# one: set SMTP_ENABLE=true and fill the SMTP_* values below, OR fill the
# MAILGUN_* values. The app warns if neither is configured, and full
# (account-verification) flows won't work until one is set.
SMTP_ENABLE=false
SMTP_HOST=smtp.yourhost.com
SMTP_PORT=465
# SMTP username, or the from-address if your provider uses that as the id.
SMTP_USERNAME=
SMTP_USER_EMAIL=mailer@yourdomain.com
SMTP_PASS=
# Mailgun alternative (ignored while SMTP_ENABLE=true).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mail.yourdomain.com
MAILGUN_SENDER=postmaster@mail.yourdomain.com

# --- Document signing certificate ---
# Base64-encoded PFX/p12 signing certificate (PEM or p12) OpenSign uses to
# sign PDFs, plus its passphrase. Leave empty to sign without a certificate.
# (A self-signed cert generated via the steps in OpenSign's docs won't show a
# valid green tick in Adobe Acrobat -- buy one from an AATL-approved CA for
# that.)
PFX_BASE64=
PASS_PHRASE=
